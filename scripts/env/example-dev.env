# Copy to scripts/env/<your-name>-dev.env, fill in real values, commit it,
# then: ln -s <your-name>-dev.env scripts/env/dev.env
# See CONTRIBUTING.md for where to get real values from.

KBDB_DEV_NAME=example
KBDB_OIDC_ISSUER_BASE_URL=https://REPLACE_ME.authkit.app
KBDB_OIDC_AUDIENCE=client_REPLACE_ME
KBDB_OIDC_MCP_AUDIENCE=https://api.example.mykeebs.dev/mcp
KBDB_CORS_ALLOW_ORIGINS=http://localhost:5173,https://example.mykeebs.dev

# Optional - only set once you've provisioned your own ACM cert for
# api.<your-name>.mykeebs.dev (see CONTRIBUTING.md's "Custom domain" section).
# KBDB_DEV_CUSTOM_DOMAIN=true
# KBDB_DEV_CUSTOM_DOMAIN_CERT_ARN=arn:aws:acm:us-east-2:123456789012:certificate/REPLACE_ME
