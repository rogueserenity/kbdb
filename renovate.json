{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommits"
  ],
  "automerge": true,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "groupName": "go toolchain version",
      "matchManagers": ["mise", "dockerfile"],
      "matchPackageNames": ["golang/go", "golang"]
    },
    {
      "matchManagers": ["mise"],
      "matchPackageNames": ["vektra/mockery"],
      "postUpgradeTasks": {
        "commands": ["mise run gen"],
        "executionMode": "branch",
        "fileFilters": ["**/mocks/*.go"]
      }
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
