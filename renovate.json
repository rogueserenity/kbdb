{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommits"
  ],
  "automerge": true,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "groupName": "go toolchain version",
      "matchManagers": ["mise", "dockerfile"],
      "matchPackageNames": ["golang/go", "golang"]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
